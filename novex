<!doctype html>
<html lang="fa" dir="rtl">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1">
<title>NOVEX | فروشگاه گیمینگ</title>
<style>
@import url('https://fonts.googleapis.com/css2?family=Vazirmatn:wght@400;600;700;800;900&display=swap');
:root{--bg:#080b0a;--panel:#111914;--line:#293a2e;--green:#a3ff4f;--mint:#42e695;--muted:#9aa99e}
*{box-sizing:border-box}
html{scroll-behavior:smooth}
body{margin:0;background:var(--bg);color:#f4f8f4;font-family:Vazirmatn,Tahoma,sans-serif}
a{text-decoration:none;color:inherit}
button,input{font:inherit}
.wrap{width:min(1160px,92%);margin:auto}
.top{height:3px;background:linear-gradient(90deg,transparent,var(--green),var(--mint),transparent)}
header{position:sticky;top:0;z-index:5;background:#080b0aee;backdrop-filter:blur(15px);border-bottom:1px solid #253329}
.nav{height:76px;display:flex;align-items:center;justify-content:space-between;gap:15px}
.logo{font-size:28px;font-weight:900;letter-spacing:2px}
.logo span{color:var(--green)}
.navlinks{display:flex;gap:25px;color:#bdc9c0;font-size:14px}
.navlinks a:hover{color:var(--green)}
button{cursor:pointer}
.cartbtn,.primary,.secondary{border:0;border-radius:12px;padding:11px 17px;font-weight:800}
.cartbtn{background:#17231a;color:var(--green);border:1px solid #35513a}
.cartbtn b{background:var(--green);color:#091009;border-radius:20px;padding:1px 7px}
.hero{padding:72px 0 60px;position:relative;overflow:hidden}
.hero:before{content:"";position:absolute;width:550px;height:550px;border-radius:50%;background:#76ff3820;filter:blur(90px);left:-170px;top:-180px}
.heroGrid{display:grid;grid-template-columns:1fr 1fr;align-items:center;gap:30px;position:relative}
.kicker{display:inline-block;color:var(--green);background:#a3ff4f12;border:1px solid #a3ff4f35;padding:7px 13px;border-radius:30px;font-size:12px;font-weight:700}
h1{font-size:clamp(40px,5vw,65px);line-height:1.25;margin:20px 0 14px;font-weight:900}
h1 em{font-style:normal;color:var(--green);text-shadow:0 0 35px #a3ff4f35}
.lead{color:#aab7ad;line-height:2;font-size:16px;max-width:520px}
.heroBtns{display:flex;gap:12px;margin-top:27px;flex-wrap:wrap}
.primary{display:inline-block;background:linear-gradient(135deg,var(--green),#62e99b);color:#071009;box-shadow:0 8px 28px #8cff4b25}
.secondary{display:inline-block;background:#151d18;border:1px solid #34463a;color:#e5eee7}
.stats{display:flex;gap:28px;margin-top:32px;flex-wrap:wrap}
.stat strong{display:block;color:var(--green)}
.stat small{color:#8e9c92}
.heroArt{min-height:350px;display:grid;place-items:center;position:relative}
.orbit{width:min(350px,80vw);aspect-ratio:1;border-radius:50%;border:1px solid #a3ff4f35;display:grid;place-items:center;background:radial-gradient(circle,#a3ff4f19,#142019 48%,#0b100d 72%);box-shadow:0 0 80px #7bff3220,inset 0 0 55px #7bff3210;position:relative}
.orbit:before{content:"";position:absolute;inset:25px;border:1px solid #a3ff4f27;border-radius:50%}
.console{font-size:125px;filter:drop-shadow(0 15px 22px #000);transform:rotate(-12deg)}
.float{position:absolute;background:#111a14;border:1px solid #334b38;padding:12px 15px;border-radius:14px;box-shadow:0 12px 35px #0008;font-size:13px}
.float strong{color:var(--green);display:block;font-size:15px}
.f1{top:35px;right:0}.f2{bottom:35px;left:0}
.strip{border-block:1px solid #202e24;background:#0d130f;padding:17px 0}
.stripin{display:flex;justify-content:space-around;gap:15px;flex-wrap:wrap;color:#b4c0b7;font-size:13px}
.stripin b{color:var(--green)}
.products{padding:65px 0 80px}
.sectionhead{display:flex;justify-content:space-between;align-items:end;gap:15px;margin-bottom:25px}
.eyebrow{color:var(--green);font-size:12px;font-weight:800}
.sectionhead h2{font-size:29px;margin:5px 0}
.sectionhead p{color:var(--muted);font-size:13px;margin:0}
